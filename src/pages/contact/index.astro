---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { site } from '../../data/site';
---

<BaseLayout
  title="Start a project"
  description="Tell Lysning Arkitekter about your site, your brief and your timeline. We reply to every enquiry within two working days."
>
  <section class="contact">
    <div class="container contact__grid">
      <div class="contact__intro">
        <h1>Start a project</h1>
        <p class="lead">Tell us about the site, the brief and the timeline. We read every message ourselves and reply within two working days.</p>
        <dl class="details">
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Studio</dt>
            <dd>{site.city}, visits by appointment</dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>{site.hours}</dd>
          </div>
        </dl>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem) var(--section);
  }

  .contact__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .contact__intro {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .details {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .details div {
    display: grid;
    gap: 0.2rem;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-line);
  }

  .details dt {
    color: var(--color-ink-2);
    font-size: var(--step--1);
  }

  .details dd {
    font-weight: 500;
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 6rem);
      align-items: start;
    }

    .contact__intro {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
