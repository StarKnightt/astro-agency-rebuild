---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtImage from '../components/ArtImage.astro';
import ServiceList from '../components/ServiceList.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import ArrowRight from '../icons/arrow-right.svg';
import ArrowUpRight from '../icons/arrow-up-right.svg';
import hero from '../assets/art/hero-fjord-dusk.jpg';
import { site } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  image: new URL('/og.jpg', Astro.site).href,
  email: site.email,
  foundingDate: String(site.founded),
  address: { '@type': 'PostalAddress', addressLocality: 'Oslo', addressCountry: 'NO' },
  areaServed: 'Norway',
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__in">Architects in Oslo since {site.founded}</p>
        <h1 class="display">Architecture for the northern light</h1>
        <p class="lead hero__in" style="--d: 1">
          We design homes, cabins and public buildings in timber and stone, shaped around low sun and long winters.
        </p>
        <div class="hero__actions hero__in" style="--d: 2">
          <a class="btn btn--primary" href="/contact">
            Start a project
            <ArrowRight width="18" height="18" aria-hidden="true" />
          </a>
          <a class="btn btn--ghost" href="/work">See our work</a>
        </div>
      </div>
      <div class="hero__media media">
        <ArtImage
          src={hero}
          priority
          alt="Illustration of a small dark cabin with warm lit windows on a headland above a fjord at dusk, with mountains and a low sun behind."
          sizes="(min-width: 82.5rem) 39rem, (min-width: 56rem) 46vw, 100vw"
          widths={[480, 800, 1200, 1600]}
        />
      </div>
    </div>
  </section>

  <section class="section intro" aria-label="About the studio">
    <div class="container intro__grid">
      <p class="intro__statement" data-reveal>
        We design for a climate of long winters and bright summer nights. Every project starts on the site, with the
        light, the terrain and the people who will use it.
      </p>
      <a class="link-arrow" href="/about" data-reveal style="--i: 1">
        About the studio
        <ArrowUpRight width="18" height="18" aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <h2 id="services-title">What we do</h2>
        <a class="link-arrow" href="/services">
          All services
          <ArrowUpRight width="18" height="18" aria-hidden="true" />
        </a>
      </div>
      <ServiceList services={services} />
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <h2 id="work-title">Selected work</h2>
        <a class="link-arrow" href="/work">
          All projects
          <ArrowUpRight width="18" height="18" aria-hidden="true" />
        </a>
      </div>
      <ProjectGrid projects={projects} />
    </div>
  </section>

  <Testimonials />

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem) 0;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-m);
    align-content: end;
  }

  .hero h1 {
    max-width: 13ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .hero__media {
    aspect-ratio: 4 / 3;
  }

  .hero__media :global(img) {
    object-position: 50% 68%;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 6rem);
      min-height: min(calc(100dvh - var(--header-h) - 2.5rem), 54rem);
    }

    .hero__copy {
      padding-bottom: var(--space-l);
    }

    .hero__media {
      aspect-ratio: 4 / 5;
      max-height: calc(100dvh - var(--header-h) - 2.5rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: hero-in 1s var(--ease-out) both;
      animation-delay: calc(var(--d, 0) * 120ms + 100ms);
    }

    .hero__media :global(img) {
      animation: hero-settle 1.8s var(--ease-out) both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.08);
    }
  }

  .intro__grid {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }

  .intro__statement {
    max-width: 30ch;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  @media (min-width: 56rem) {
    .intro__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(2rem, 5vw, 6rem);
    }

    .intro__grid > * {
      grid-column: 2;
    }

    .intro__statement {
      max-width: 26ch;
      font-size: var(--step-3);
    }
  }
</style>
