---
import Logo from './Logo.astro';
import ArrowRight from '../icons/arrow-right.svg';
import MenuIcon from '../icons/list.svg';
import CloseIcon from '../icons/x.svg';
import { nav, site } from '../data/site';
import { cleanPath } from '../lib/paths';

const path = cleanPath(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<div class="sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="header" data-header>
  <div class="container bar">
    <Logo />
    <nav class="desktop-nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-astro-prefetch>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--primary header-cta" href="/contact" data-astro-prefetch>
      Start a project
      <ArrowRight width="18" height="18" aria-hidden="true" />
    </a>
    <button class="icon-btn menu-button" type="button" data-menu-open aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu">
      <MenuIcon width="22" height="22" aria-hidden="true" />
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<dialog class="menu" id="site-menu" data-menu aria-label="Site menu">
  <div class="container bar">
    <Logo />
    <button class="icon-btn" type="button" data-menu-close autofocus>
      <CloseIcon width="22" height="22" aria-hidden="true" />
      <span class="visually-hidden">Close menu</span>
    </button>
  </div>
  <nav class="container menu__nav" aria-label="Mobile">
    <ul role="list">
      {
        nav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn--primary" href="/contact">
      Start a project
      <ArrowRight width="18" height="18" aria-hidden="true" />
    </a>
  </nav>
  <div class="container menu__foot">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>{site.city}</span>
  </div>
</dialog>

<script>
  import '../scripts/header';
</script>

<style>
  .sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 2rem;
    pointer-events: none;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    transition:
      background-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .header:global(.is-scrolled) {
    background: rgb(240 242 239 / 0.82);
    box-shadow: 0 1px 0 var(--color-line);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  @media (prefers-reduced-transparency: reduce) {
    .header:global(.is-scrolled) {
      background: var(--color-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    height: var(--header-h);
  }

  .desktop-nav {
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }

  .desktop-nav a {
    position: relative;
    display: block;
    padding-block: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 55.99rem) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-button {
      display: inline-grid;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 max(1.5rem, env(safe-area-inset-bottom));
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__nav {
    display: grid;
    align-content: start;
    gap: var(--space-xl);
    padding-top: clamp(2rem, 8vh, 4rem);
  }

  .menu__nav ul {
    display: grid;
    gap: 0.25rem;
  }

  .menu__nav li a {
    display: block;
    padding-block: 0.35rem;
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .menu__nav li a[aria-current='page'] {
    color: var(--color-pine);
  }

  .menu__nav .btn {
    justify-self: start;
  }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: auto;
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-2);
    font-size: var(--step--1);
  }

  .menu__foot a {
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu {
      opacity: 0;
      transform: translateY(-0.75rem);
      transition:
        opacity 0.3s ease,
        transform 0.45s var(--ease-out),
        overlay 0.45s allow-discrete,
        display 0.45s allow-discrete;
    }

    .menu[open] {
      opacity: 1;
      transform: none;
    }

    @starting-style {
      .menu[open] {
        opacity: 0;
        transform: translateY(-0.75rem);
      }
    }

    .menu[open] .menu__nav li {
      animation: menu-item 0.6s var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 55ms + 90ms);
    }
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
