---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes, widths = [480, 800, 1200, 1600], priority = false, class: className } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
const width = usable.at(-1) ?? src.width;
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={usable}
  width={width}
  height={Math.round((width / src.width) * src.height)}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  priority={priority}
  class={className}
/>
