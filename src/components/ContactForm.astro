---
import ArrowRight from '../icons/arrow-right.svg';
import { BUDGETS, HONEYPOT_FIELD, LIMITS, PROJECT_TYPES } from '../lib/contact';
import { site } from '../data/site';
---

<div class="contact-card" id="contact-form">
  <p class="form-alert" id="form-invalid" role="alert">Some fields need another look. Please check the form and send it again.</p>
  <p class="form-alert" id="form-failed" role="alert">
    We could not send your message just now. Please try again in a minute, or email <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>

  <form class="form" method="post" action="/api/contact" data-contact-form data-email={site.email}>
    <div class="row">
      <div class="field">
        <label for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          minlength={LIMITS.name.min}
          maxlength={LIMITS.name.max}
          aria-describedby="name-error"
          data-field
          data-required-message="Please tell us your name."
        />
        <p class="error" id="name-error" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          required
          maxlength={LIMITS.email.max}
          aria-describedby="email-error"
          data-field
          data-required-message="Please enter your email so we can reply."
        />
        <p class="error" id="email-error" aria-live="polite"></p>
      </div>
    </div>

    <div class="row">
      <div class="field">
        <label for="projectType">Project type</label>
        <select id="projectType" name="projectType" required aria-describedby="projectType-error" data-field data-required-message="Please choose a project type.">
          <option value="">Choose one</option>
          {PROJECT_TYPES.map((type) => <option value={type}>{type}</option>)}
        </select>
        <p class="error" id="projectType-error" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for="budget">Budget <span class="optional">(optional)</span></label>
        <select id="budget" name="budget" aria-describedby="budget-error" data-field>
          {BUDGETS.map((budget) => <option value={budget}>{budget}</option>)}
        </select>
        <p class="error" id="budget-error" aria-live="polite"></p>
      </div>
    </div>

    <div class="field">
      <label for="location">Site location <span class="optional">(optional)</span></label>
      <input
        id="location"
        name="location"
        type="text"
        autocomplete="address-level2"
        maxlength={LIMITS.location.max}
        aria-describedby="location-hint location-error"
        data-field
      />
      <p class="hint" id="location-hint">A town or municipality is enough.</p>
      <p class="error" id="location-error" aria-live="polite"></p>
    </div>

    <div class="field">
      <label for="message">About the project</label>
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        minlength={LIMITS.message.min}
        maxlength={LIMITS.message.max}
        aria-describedby="message-hint message-error"
        data-field
        data-required-message="Please tell us a little about the project."></textarea>
      <p class="hint" id="message-hint">The site, what you want to build and roughly when. At least {LIMITS.message.min} characters.</p>
      <p class="error" id="message-error" aria-live="polite"></p>
    </div>

    <div class="hp" aria-hidden="true">
      <label for={HONEYPOT_FIELD}>Leave this field empty</label>
      <input id={HONEYPOT_FIELD} name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="actions">
      <button class="btn btn--primary" type="submit">
        <span data-label>Send message</span>
        <ArrowRight width="18" height="18" aria-hidden="true" />
      </button>
      <p class="privacy">We only use your details to reply to this enquiry.</p>
    </div>
    <p class="status" data-form-status role="status"></p>
  </form>

  <div class="success" data-form-success tabindex="-1" hidden>
    <h2>Thank you. Your message is with us.</h2>
    <p>One of the partners will read it and reply within two working days.</p>
    <p class="demo-note" data-demo-note hidden>
      Demo mode: the message passed server-side validation, but no email was sent because this deployment has no
      <code>RESEND_API_KEY</code>. With a key configured, the same endpoint sends it through Resend.
    </p>
  </div>
</div>

<script>
  import '../scripts/contact-form';
</script>

<style>
  .contact-card {
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    background: var(--color-paper-2);
  }

  .form {
    display: grid;
    gap: var(--space-m);
  }

  .row {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .field {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  label {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .optional {
    color: var(--color-ink-2);
    font-weight: 400;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0;
    background: var(--color-paper);
    font-size: 1rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  textarea {
    min-height: 9rem;
    resize: vertical;
    line-height: 1.5;
  }

  select {
    appearance: none;
    padding-right: 2.75rem;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 1.3rem) 52%,
      calc(100% - 0.95rem) 52%;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--color-ink-2);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-pine);
    outline: none;
    box-shadow: 0 0 0 3px rgb(31 74 61 / 0.25);
  }

  [aria-invalid='true'] {
    border-color: var(--color-error);
  }

  [aria-invalid='true']:focus-visible {
    box-shadow: 0 0 0 3px rgb(163 38 27 / 0.2);
  }

  .hint {
    color: var(--color-ink-2);
    font-size: var(--step--1);
  }

  .error {
    color: var(--color-error);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .error:empty {
    display: none;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-2xs);
  }

  .actions .btn[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  .privacy {
    color: var(--color-ink-2);
    font-size: var(--step--1);
  }

  .status:empty {
    display: none;
  }

  .status {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .status[data-tone='error'] {
    color: var(--color-error);
  }

  .form-alert {
    display: none;
    margin-bottom: var(--space-m);
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-error);
    background: var(--color-paper);
    color: var(--color-error);
    font-weight: 500;
  }

  .form-alert:target {
    display: block;
  }

  .success {
    display: grid;
    gap: var(--space-s);
    outline: none;
  }

  .success h2 {
    font-size: var(--step-3);
  }

  .demo-note {
    margin-top: var(--space-s);
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-pine);
    background: var(--color-paper);
    font-size: 0.9375rem;
  }

  code {
    font-size: 0.875em;
  }
</style>
