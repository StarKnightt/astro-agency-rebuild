{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astro-agency-rebuild",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
